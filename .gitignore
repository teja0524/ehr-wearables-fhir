# Vector store — rebuilt automatically on first run
.chromadb/

# Environment variables — contains your secret API key
.env

# Python cache
__pycache__/
*.pyc
*.pyo

# Virtual environment
venv/
env/

# Mac system files
.DS_Store

# Output files — generated by the pipeline
output/

# R history (you have a .Rhistory in there)
.Rhistory