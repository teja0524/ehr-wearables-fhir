# Copy to .env and fill in:  cp .env.example .env
#
# This file holds credentials. Behavioural settings (validator, terminology
# server, FHIR namespace, dashboard port) are documented in the README and can
# also be set here as environment variables if you need to override a default.

# --- Required: LLM used by the code mapper ---------------------------------
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# --- Optional: UMLS, for extending the terminology seed --------------------
# Free UTS account: https://uts.nlm.nih.gov/uts/profile
# Used by: python main.py --enrich-seed
UMLS_API_KEY=

# --- Optional: other model providers (routed via LiteLLM) ------------------
# Only needed if you select one of these with --model or in the dashboard.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
